---
import { Image } from 'astro:assets';
import { siteConfig, getCategoryWhatsAppUrl, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

// Import 7 foto fashion asli
import fotoBaju from '../assets/kategori/baju.jpg';
import fotoCelana from '../assets/kategori/celana.jpg';
import fotoTas from '../assets/kategori/tas.jpg';
import fotoJam from '../assets/kategori/jam-tangan.jpg';
import fotoSepatu from '../assets/kategori/sepatu-sandal.jpg';
import fotoHijab from '../assets/kategori/hijab.jpg';
import fotoSkincare from '../assets/kategori/skincare-makeup.jpg';

const categoryImages: Record<string, ImageMetadata> = {
  'baju': fotoBaju,
  'celana': fotoCelana,
  'tas': fotoTas,
  'jam-tangan': fotoJam,
  'sepatu-sandal': fotoSepatu,
  'hijab': fotoHijab,
  'skincare-makeup': fotoSkincare,
};

const waOtherUrl = getWhatsAppUrl('Halo Kak Izah, saya mau tanya titip jual barang lainnya yang belum ada di daftar');
---

<section id="kategori" class="py-16 sm:py-24 bg-white border-b border-stone-200/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading (ALLU Inspired: Minimalist, Bold & Clean) -->
    <div class="max-w-2xl mb-12 sm:mb-16 fade-up-element text-center sm:text-left">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Barang yang Diterima
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        7 Kategori Barang Pilihan
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Pilih kategori barang preloved yang ingin kamu jual. Klik foto untuk langsung terhubung ke WhatsApp Kak Izah.
      </p>
    </div>

    <!-- Category Grid (ALLU Style: Real Product Photos, No Thick Card Nesting) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-8 mb-20 font-body">
      {siteConfig.categories.map((cat, idx) => {
        const img = categoryImages[cat.slug];
        const waCatUrl = getCategoryWhatsAppUrl(cat.nama);
        return (
          <a
            href={waCatUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="fade-up-element group block"
          >
            <!-- Real Editorial Photo Frame -->
            <div class="aspect-[4/5] w-full overflow-hidden rounded-xl bg-stone-100 relative mb-3.5">
              {img && (
                <Image
                  src={img}
                  alt={cat.alt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                />
              )}
              
              <!-- Clean Minimal Index -->
              <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-warmtext-dark text-[11px] font-medium px-2.5 py-0.5 rounded-full">
                0{idx + 1}
              </span>
            </div>

            <!-- Typography & Action (Under the Photo, Clean & Elegant) -->
            <div>
              <h3 class="font-heading font-bold text-xl sm:text-2xl text-warmtext-dark group-hover:text-rosebrand-600 transition-colors leading-snug">
                {cat.nama}
              </h3>
              <p class="text-xs text-warmtext-muted line-clamp-1 mt-0.5 mb-2 font-normal">
                {cat.sub}
              </p>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-rosebrand-600 group-hover:translate-x-1 transition-transform">
                <span>Titip {cat.nama}</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </span>
            </div>
          </a>
        );
      })}

      <!-- 8th Slot: Penutup Rapi Simetris (No Nested Card Bloat) -->
      <a
        href={waOtherUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="fade-up-element group block border border-dashed border-stone-300 hover:border-rosebrand-600 rounded-xl p-5 sm:p-6 bg-cream-50 flex flex-col justify-between transition-colors text-center sm:text-left"
      >
        <div class="my-auto py-2">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-rosebrand-600 block mb-2">
            Punya Barang Lain?
          </span>
          <h3 class="font-heading font-bold text-2xl text-warmtext-dark mb-2">
            Tanya Dulu ke Kak Izah
          </h3>
          <p class="text-xs text-warmtext-muted leading-relaxed mb-4">
            Punya barang wanita di luar 7 kategori ini? Konsultasikan dulu lewat WhatsApp untuk cek kelayakan barangmu.
          </p>
        </div>

        <span class="inline-flex items-center justify-center sm:justify-start gap-1.5 text-xs font-semibold text-rosebrand-600 group-hover:text-rosebrand-700">
          <span>Chat WhatsApp Sekarang</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </span>
      </a>
    </div>

    <!-- Guideline Section (ALLU Style: Clean Minimalist Two-Column List, No Card Box) -->
    <div class="fade-up-element pt-12 border-t border-stone-200/80 font-body">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12">
        
        <!-- Standar Kondisi Barang yang Diterima -->
        <div>
          <div class="flex items-center gap-2 mb-3 text-warmtext-dark font-semibold text-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Standar Kondisi Barang yang Diterima</span>
          </div>
          <ul class="text-xs sm:text-sm text-warmtext-muted space-y-2.5 pl-4 border-l-2 border-emerald-500/40">
            <li><strong>Standar umum:</strong> Barang dalam kondisi bersih, layak pakai, dan layak jual.</li>
            <li><strong>Kondisi jujur:</strong> Kondisi wajib dijelaskan jujur di foto dan caption (termasuk jika ada minus). Penitip yang terbukti menipu customer akan di-blacklist.</li>
            <li><strong>Kelengkapan asli:</strong> Box, dustbag, atau nota belanja asli (jika masih ada) mohon disebutkan di caption.</li>
            <li><strong>Barang branded (tas, jam tangan, dll):</strong> Status barang (original / non-original) wajib dijelaskan jujur di caption. Dilarang menyebut barang non-original sebagai original. Detail dan kualitas dibahas lewat WhatsApp sebelum barang diterima.</li>
            <li><strong>Skincare &amp; makeup:</strong> Diterima walau segel/plastik sudah dibuka atau tanpa box, selama belum kedaluwarsa dan kondisinya dijelaskan jujur di caption (sisa isi, sudah dibuka atau belum). Tanggal kedaluwarsa / nomor batch wajib terlihat jelas di foto. <span class="text-rosebrand-700 font-medium">[KONFIRMASI IZAH: apakah produk yang sangat personal seperti lipstik/maskara bekas pakai diterima atau tidak]</span></li>
          </ul>
        </div>

        <!-- Barang yang Tidak Diterima -->
        <div>
          <div class="flex items-center gap-2 mb-3 text-warmtext-dark font-semibold text-sm">
            <span class="w-2 h-2 rounded-full bg-rosebrand-600"></span>
            <span>Barang yang Tidak Diterima</span>
          </div>
          <ul class="text-xs sm:text-sm text-warmtext-muted space-y-2.5 pl-4 border-l-2 border-rosebrand-600/40">
            <li>Pakaian dengan noda permanen, robek parah, luntur parah, atau bau tidak sedap.</li>
            <li>Barang yang mengalami kerusakan mayor atau cacat berat.</li>
            <li>Produk skincare atau kosmetik yang sudah kedaluwarsa atau tanggal kedaluwarsanya tidak terbaca.</li>
            <li>Barang yang sengaja dipalsukan keterangannya saat difoto/dijelaskan.</li>
          </ul>
        </div>

      </div>
    </div>

  </div>
</section>
