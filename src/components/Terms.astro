---
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

const termsList = siteConfig.termsAndConditions;
const waUrl = getWhatsAppUrl('Halo Kak Izah, saya mau tanya syarat titip jual pakaian');
---

<section id="syarat-ketentuan" class="py-16 sm:py-24 bg-white border-b border-stone-200/70">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading (ALLU Inspired: Minimalist) -->
    <div class="max-w-2xl mb-12 sm:mb-16 fade-up-element text-center sm:text-left">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Ketentuan Penitip
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        Syarat &amp; Ketentuan Layanan
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Harap membaca syarat dan ketentuan berikut sesuai sistem yang kamu pilih agar proses jual beli berjalan aman, transparan, dan saling menguntungkan.
      </p>
    </div>

    <!-- Accordion Native <details> (Satu per sistem, Styling Elegan & Bersih) -->
    <div class="space-y-5 font-body">
      {termsList.map((item, idx) => (
        <details
          class="group rounded-2xl border border-stone-200/90 bg-cream-50/50 p-6 sm:p-7 transition-all duration-200 open:bg-white open:border-rosebrand-300 open:shadow-sm"
          open={idx === 0}
        >
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none select-none focus:outline-none">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-rosebrand-100 text-rosebrand-700 flex items-center justify-center text-xs font-bold shrink-0">
                0{idx + 1}
              </span>
              <div>
                <h3 class="font-heading font-bold text-xl sm:text-2xl text-warmtext-dark group-hover:text-rosebrand-600 transition-colors">
                  {item.systemTitle}
                </h3>
                <p class="text-xs text-warmtext-muted mt-0.5 hidden sm:block">
                  {item.systemSubtitle}
                </p>
              </div>
            </div>

            <!-- Chevron indicator -->
            <span class="w-7 h-7 rounded-full bg-stone-100 group-hover:bg-rosebrand-100 flex items-center justify-center text-stone-400 group-hover:text-rosebrand-600 transition-transform duration-300 group-open:rotate-180 shrink-0">
              <Icon name="chevron-down" class="w-4 h-4" />
            </span>
          </summary>

          <div class="pt-6 mt-4 border-t border-stone-200/70 text-xs sm:text-sm text-warmtext-muted leading-relaxed">
            <ol class="list-decimal pl-5 space-y-3 text-warmtext-dark">
              {item.terms.map((t) => (
                <li class="pl-1 leading-relaxed">
                  {t}
                </li>
              ))}
            </ol>

            <div class="mt-6 p-4 rounded-xl bg-cream-50 border border-blush-200 text-xs text-rosebrand-900 font-medium">
              📌 {item.closingNote}
            </div>
          </div>
        </details>
      ))}
    </div>

    <!-- Extra WA Contact Prompt -->
    <div class="mt-10 text-center sm:text-left fade-up-element font-body">
      <span class="text-xs sm:text-sm text-warmtext-muted mr-2">
        Ada poin syarat yang masih ingin kamu tanyakan?
      </span>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-semibold text-rosebrand-600 hover:text-rosebrand-700 text-xs sm:text-sm"
      >
        <span>Tanya langsung ke Kak Izah via WhatsApp</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</section>

