---
import { Image } from 'astro:assets';
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';
import logoImg from '../assets/logo.jpg';

const waUrl = getWhatsAppUrl();
---

<header class="sticky top-0 z-40 bg-cream-50/95 backdrop-blur-sm border-b border-blush-100 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 sm:h-20 flex items-center justify-between font-body">
    
    <!-- Logo Gambar Asli Titip Jual Izah -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="h-11 w-11 sm:h-12 sm:w-12 rounded-2xl overflow-hidden border border-blush-200 shadow-sm bg-white shrink-0 group-hover:scale-105 transition-transform">
        <Image
          src={logoImg}
          alt={`Logo Resmi ${siteConfig.brandName}`}
          class="w-full h-full object-cover"
        />
      </div>
      <div>
        <span class="font-heading font-semibold text-2xl sm:text-3xl text-warmtext-dark tracking-tight block leading-none">
          {siteConfig.brandName}
        </span>
        <span class="text-[11px] font-medium text-rosebrand-600 tracking-wider uppercase block mt-1 font-body">
          by {siteConfig.ownerName}
        </span>
      </div>
    </a>

    <!-- Nav Links (DM Sans 500) -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-warmtext-muted">
      <a href="#cara-kerja" class="hover:text-rosebrand-600 transition-colors">Cara Kerja</a>
      <a href="#keuntungan" class="hover:text-rosebrand-600 transition-colors">Keuntungan</a>
      <a href="#kategori" class="hover:text-rosebrand-600 transition-colors">Kategori</a>
      <a href="#komisi" class="hover:text-rosebrand-600 transition-colors">Komisi</a>
      <a href="#terjual" class="hover:text-rosebrand-600 transition-colors">Terjual</a>
      <a href="#testimoni" class="hover:text-rosebrand-600 transition-colors">Testimoni</a>
      <a href="#faq" class="hover:text-rosebrand-600 transition-colors">FAQ</a>
    </nav>

    <!-- Top WhatsApp Button (DM Sans 600) -->
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-rosebrand-600 hover:bg-rosebrand-700 text-white shadow-btn hover:-translate-y-0.5 active:translate-y-0 transition-all"
    >
      <Icon name="message-circle" class="w-4 h-4 text-white" />
      <span>Chat WhatsApp</span>
    </a>

  </div>
</header>
