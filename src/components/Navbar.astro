---
import { Image } from 'astro:assets';
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';
import logoImg from '../assets/logo.png';

const waUrl = getWhatsAppUrl();
---

<header class="sticky top-0 z-40 bg-cream-50/95 backdrop-blur-sm border-b border-blush-100 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 sm:h-20 flex items-center justify-between font-body">
    
    <!-- Logo Gambar Transparan Titip Jual Izah -->
    <a href="/" class="flex items-center group py-1" aria-label={siteConfig.brandName}>
      <div class="h-11 sm:h-13 flex items-center justify-center transition-transform group-hover:scale-105">
        <Image
          src={logoImg}
          alt={`Logo Resmi ${siteConfig.brandName}`}
          class="h-10 sm:h-12 w-auto object-contain"
          loading="eager"
        />
      </div>
    </a>

    <!-- Nav Links (DM Sans 500) -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-7 text-sm font-medium text-warmtext-muted">
      <a href="#pilih-sistem" class="hover:text-rosebrand-600 transition-colors">Pilih Sistem</a>
      <a href="#alur-daftar" class="hover:text-rosebrand-600 transition-colors">Alur Daftar</a>
      <a href="#syarat-ketentuan" class="hover:text-rosebrand-600 transition-colors">Syarat &amp; Ketentuan</a>
      <a href="#kategori" class="hover:text-rosebrand-600 transition-colors">Kategori</a>
      <a href="#testimoni" class="hover:text-rosebrand-600 transition-colors">Testimoni</a>
    </nav>

    <!-- Top WhatsApp Button (DM Sans 600) -->
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-rosebrand-600 hover:bg-rosebrand-700 text-white shadow-btn hover:-translate-y-0.5 active:translate-y-0 transition-all"
    >
      <Icon name="message-circle" class="w-4 h-4 text-white" />
      <span>Chat WhatsApp</span>
    </a>

  </div>
</header>
