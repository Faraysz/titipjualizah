---
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

const waUrl = getWhatsAppUrl('Halo Kak Izah, saya mau tanya-tanya seputar syarat titip jual');
---

<section id="faq" class="py-16 sm:py-24 bg-white border-b border-stone-200/70">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading (ALLU Inspired: Minimalist) -->
    <div class="max-w-2xl mb-12 sm:mb-16 fade-up-element text-center sm:text-left">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Tanya Jawab
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        Pertanyaan Umum
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Informasi seputar 7 kategori barang yang diterima, syarat kondisi, keamanan, hingga pencairan dana.
      </p>
    </div>

    <!-- Minimalist Horizontal Divider Accordion with Smooth CSS Grid Animation -->
    <div class="divide-y divide-stone-200/80 font-body border-t border-b border-stone-200/80" id="faq-accordion-group">
      {siteConfig.faqs.map((faq, idx) => (
        <div class={`faq-item py-4 sm:py-5 transition-colors ${idx === 0 ? 'is-open' : ''}`}>
          <button
            type="button"
            class="faq-toggle w-full text-left flex items-center justify-between gap-4 font-body font-semibold text-base sm:text-lg text-warmtext-dark cursor-pointer select-none focus:outline-none group py-1"
            aria-expanded={idx === 0 ? "true" : "false"}
          >
            <span class="group-hover:text-rosebrand-600 transition-colors leading-snug">{faq.question}</span>
            <span class="faq-chevron text-stone-400 group-hover:text-rosebrand-600 transition-transform duration-300 shrink-0">
              <Icon name="chevron-down" class="w-5 h-5" />
            </span>
          </button>
          
          <!-- Smooth Animated Content Wrapper -->
          <div class="faq-content-wrapper">
            <div class="faq-content-inner">
              <p class="pt-3 pb-2 text-xs sm:text-sm text-warmtext-muted leading-relaxed">
                {faq.answer}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Extra WA Contact Prompt -->
    <div class="mt-12 text-center sm:text-left fade-up-element font-body">
      <span class="text-xs sm:text-sm text-warmtext-muted mr-2">
        Ada pertanyaan lain yang belum terjawab?
      </span>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-semibold text-rosebrand-600 hover:text-rosebrand-700 text-xs sm:text-sm"
      >
        <span>Hubungi Kak Izah via WhatsApp</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</section>

<style>
  /* Smooth Slide Down / Slide Up Animation using CSS Grid */
  .faq-content-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .faq-content-inner {
    overflow: hidden;
  }

  .faq-item.is-open .faq-content-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .faq-chevron {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item.is-open .faq-chevron {
    transform: rotate(180deg);
    color: #e11d48;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content-wrapper,
    .faq-chevron {
      transition: none !important;
    }
  }
</style>

<script>
  // Smooth Accordion Logic with Single Open / Toggle
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach((item) => {
    const toggle = item.querySelector('.faq-toggle');

    toggle?.addEventListener('click', () => {
      const isOpen = item.classList.contains('is-open');

      // Tutup semua FAQ lain dengan animasi mulus
      faqItems.forEach((other) => {
        if (other !== item && other.classList.contains('is-open')) {
          other.classList.remove('is-open');
          const otherToggle = other.querySelector('.faq-toggle');
          otherToggle?.setAttribute('aria-expanded', 'false');
        }
      });

      // Toggle item ini
      if (isOpen) {
        item.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
