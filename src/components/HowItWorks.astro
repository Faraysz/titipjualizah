---
import Icon from './Icon.astro';
import { getWhatsAppUrl } from '../config/site';

const waUrl = getWhatsAppUrl();

const steps = [
  {
    number: '01',
    title: 'Kirim Foto via WhatsApp',
    desc: 'Foto barangmu dari HP dengan pencahayaan cukup. Kirimkan info merek, ukuran, kondisi, dan kelengkapannya ke WA Kak Izah.',
  },
  {
    number: '02',
    title: 'Penetapan Harga & Promosi',
    desc: 'Setelah harga disepakati bersama, Kak Izah mempromosikan barangmu dengan deskripsi rapi ke jaringan pembeli cewek.',
  },
  {
    number: '03',
    title: 'Barang Laku Terjual',
    desc: 'Ada pembeli yang berminat dan transfer. Kak Izah yang menangani obrolan pembeli, pembayaran, dan pengiriman aman.',
  },
  {
    number: '04',
    title: 'Pencairan Dana ke Rekening',
    desc: 'Setelah barang diterima pembeli tanpa kendala, uang penjualan dikurangi komisi langsung ditransfer ke rekening bank kamu.',
  },
];
---

<section id="cara-kerja" class="py-16 sm:py-24 bg-cream-50 border-b border-stone-200/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading (ALLU Inspired: Clean & Editorial) -->
    <div class="max-w-2xl mb-14 sm:mb-18 fade-up-element text-center sm:text-left">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Alur Transaksi
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        4 Langkah Mudah Titip Jual
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Proses mudah dari rumah. Kamu cukup siapkan barang, biar Izah yang mengurus seluruh promosi sampai dana cair.
      </p>
    </div>

    <!-- Editorial Stepper (No Card Boxes, Clean Numbered Flow) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 font-body relative">
      {steps.map((step, idx) => (
        <div class="fade-up-element flex flex-col justify-between pt-6 border-t-2 border-stone-200 hover:border-rosebrand-600 transition-colors">
          <div>
            <!-- Large Minimalist Number (Cormorant Garamond) -->
            <span class="font-heading font-light text-4xl sm:text-5xl text-rosebrand-700/80 block mb-4">
              {step.number}
            </span>

            <h3 class="font-heading font-bold text-xl sm:text-2xl text-warmtext-dark mb-2 leading-snug">
              {step.title}
            </h3>
            
            <p class="text-xs sm:text-sm text-warmtext-muted leading-relaxed font-normal">
              {step.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 text-[11px] font-medium text-warmtext-soft flex items-center gap-1">
            <span>Tahap {idx + 1} dari 4</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Sub-CTA Text Link -->
    <div class="mt-14 pt-8 border-t border-stone-200/70 text-center sm:text-left fade-up-element font-body">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-rosebrand-700 hover:text-rosebrand-800"
      >
        <span>Punya barang yang mau dititipkan? Hubungi Kak Izah via WhatsApp</span>
        <Icon name="arrow-right" class="w-4 h-4 text-rosebrand-600" />
      </a>
    </div>

  </div>
</section>
