---
import Icon from './Icon.astro';
import { getWhatsAppUrl } from '../config/site';

const waUrl = getWhatsAppUrl();

const steps = [
  {
    number: '01',
    title: 'Kirim Foto & Detail via WA',
    desc: 'Foto barang yang ingin kamu titipkan dari HP dengan pencahayaan cukup. Kirimkan merek, ukuran, kondisi, dan kelengkapannya ke WA Kak Izah.',
    icon: 'camera' as const,
  },
  {
    number: '02',
    title: 'Izah Promosikan',
    desc: 'Setelah harga disepakati bersama, Kak Izah menyusun deskripsi estetik, memilah foto, dan mempromosikannya ke calon pembeli cewek yang relevan.',
    icon: 'sparkles' as const,
  },
  {
    number: '03',
    title: 'Barang Laku Terjual',
    desc: 'Ada pembeli yang berminat dan transfer! Kak Izah yang menangani obrolan pembeli, pembayaran, pengemasan aman, hingga pengiriman resi.',
    icon: 'shopping-bag' as const,
  },
  {
    number: '04',
    title: 'Uang Ditransfer ke Kamu',
    desc: 'Begitu barang diterima dan terkonfirmasi pembeli, uang penjualan setelah dipotong komisi langsung dikirim ke rekening bank atau e-wallet kamu.',
    icon: 'banknote' as const,
  },
];
---

<section id="cara-kerja" class="py-16 sm:py-24 bg-white border-b border-blush-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading -->
    <div class="text-center max-w-2xl mx-auto mb-14 fade-up-element">
      <span class="text-rosebrand-600 font-semibold text-xs tracking-widest uppercase mb-2 block">
        Alur Praktis
      </span>
      <h2 class="font-heading font-bold text-2xl sm:text-4xl text-warmtext-dark tracking-tight mb-4">
        4 Langkah Mudah Titip Jual di Izah
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed">
        Kamu cukup siapkan barang dari rumah, biarkan Izah yang menangani seluruh proses promosi sampai uang masuk rekening.
      </p>
    </div>

    <!-- Steps Grid / Numbered List -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {steps.map((step, idx) => (
        <div class="fade-up-element bg-cream-50 rounded-3xl p-6 border border-blush-100 flex flex-col justify-between hover:border-blush-200 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-heading font-bold text-2xl text-rosebrand-600">
                {step.number}
              </span>
              <div class="w-10 h-10 rounded-xl bg-white border border-blush-100 flex items-center justify-center text-rosebrand-700 shadow-sm">
                <Icon name={step.icon} class="w-5 h-5 text-rosebrand-600" />
              </div>
            </div>

            <h3 class="font-heading font-bold text-lg text-warmtext-dark mb-2.5">
              {step.title}
            </h3>
            <p class="text-xs sm:text-sm text-warmtext-muted leading-relaxed">
              {step.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-blush-100/70 text-[11px] font-medium text-warmtext-soft flex items-center gap-1.5">
            <span>Tahap {idx + 1} dari 4</span>
            <Icon name="arrow-right" class="w-3 h-3 text-rosebrand-600" />
          </div>
        </div>
      ))}
    </div>

    <!-- Section Sub-CTA -->
    <div class="mt-12 text-center fade-up-element">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-rosebrand-700 hover:text-rosebrand-800 bg-blush-50 hover:bg-blush-100 border border-blush-200 px-6 py-3 rounded-full transition-colors"
      >
        <span>Punya barang yang mau dititipkan? Tanya Kak Izah sekarang</span>
        <Icon name="arrow-right" class="w-4 h-4 text-rosebrand-600" />
      </a>
    </div>

  </div>
</section>

