---
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

const systems = siteConfig.serviceSystems;
const comparisons = siteConfig.comparisonRows;
---

<section id="pilih-sistem" class="py-16 sm:py-24 bg-white border-b border-stone-200/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading (ALLU Inspired: Clean & Editorial) -->
    <div class="max-w-2xl mb-12 sm:mb-16 fade-up-element text-center sm:text-left">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Pilihan Layanan Nyata
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        Pilih Sistem Titip Jualmu
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Mau santai terima beres sampai uang cair, atau mau hemat biaya dan pegang barang sendiri? Pilih yang paling pas buat kebutuhanmu.
      </p>
    </div>

    <!-- 2 Cards Grid: Desain Tidak Identik (Mobile: Bertumpuk, Desktop: Berdampingan) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-stretch mb-16 font-body">
      
      <!-- Sistem 1: TERIMA BERES (Lebih Menonjol - Paling Praktis) -->
      <div class="lg:col-span-6 fade-up-element rounded-2xl bg-cream-50 border-2 border-rosebrand-600/90 p-6 sm:p-9 flex flex-col justify-between shadow-sm relative">
        <div>
          <!-- Header Card & Badge -->
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-white bg-rosebrand-600 px-3 py-1 rounded-full shadow-xs">
              <Icon name="check" class="w-3.5 h-3.5" />
              <span>{systems[0].badge}</span>
            </span>
            <span class="text-xs text-rosebrand-700 font-medium">Baju dikirim ke admin</span>
          </div>

          <h3 class="font-heading font-bold text-2xl sm:text-3xl text-warmtext-dark mb-2">
            {systems[0].nama}
          </h3>

          <p class="text-xs sm:text-sm text-warmtext-muted leading-relaxed mb-6">
            {systems[0].tagline}
          </p>

          <!-- Biaya Highlight -->
          <div class="bg-white rounded-xl p-4 sm:p-5 border border-rosebrand-200/80 mb-6">
            <div class="flex items-baseline gap-2 mb-1">
              <span class="font-heading font-bold text-3xl sm:text-4xl text-rosebrand-700">
                {systems[0].biaya}
              </span>
            </div>
            <p class="text-xs text-warmtext-muted leading-relaxed">
              {systems[0].biayaDetail}
            </p>
          </div>

          <!-- Cocok Untuk -->
          <div class="mb-6 pb-6 border-b border-stone-200/80 text-xs sm:text-sm text-warmtext-dark">
            <p class="font-semibold text-rosebrand-700 mb-1">Keunggulan Utama:</p>
            <p class="text-warmtext-muted leading-relaxed">{systems[0].keunggulan} {systems[0].cocokUntuk}</p>
          </div>

          <!-- Checklist Pekerjaan Admin -->
          <div class="mb-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-warmtext-dark mb-3">
              {systems[0].checklistTitle}
            </p>
            <ul class="text-xs sm:text-sm text-warmtext-muted space-y-2.5">
              {systems[0].checklist.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
                    <Icon name="check" class="w-3 h-3" />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Media Promosi -->
          <div class="p-3.5 rounded-lg bg-rosebrand-50 border border-rosebrand-200/50 text-xs text-rosebrand-900 leading-relaxed mb-6">
            <strong class="font-semibold block mb-0.5">Media Promosi:</strong>
            {systems[0].mediaPromosi}
          </div>
        </div>

        <!-- Tombol Action -->
        <div class="pt-4 border-t border-rosebrand-200/70">
          <a
            href={getWhatsAppUrl(systems[0].waMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-sm bg-rosebrand-600 hover:bg-rosebrand-700 text-white shadow-btn hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-2"
          >
            <Icon name="message-circle" class="w-4 h-4 text-white" />
            <span>{systems[0].buttonText}</span>
          </a>
        </div>
      </div>

      <!-- Sistem 2: TITIP JUAL BIASA (Lebih Ringan & Bersih) -->
      <div class="lg:col-span-6 fade-up-element rounded-2xl bg-white border border-stone-300 hover:border-stone-400 p-6 sm:p-9 flex flex-col justify-between shadow-xs transition-colors relative">
        <div>
          <!-- Header Card & Badge -->
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-stone-700 bg-stone-100 px-3 py-1 rounded-full border border-stone-200">
              <span>{systems[1].badge}</span>
            </span>
            <span class="text-xs text-stone-500 font-medium">Barang di rumah kamu</span>
          </div>

          <h3 class="font-heading font-bold text-2xl sm:text-3xl text-warmtext-dark mb-2">
            {systems[1].nama}
          </h3>

          <p class="text-xs sm:text-sm text-warmtext-muted leading-relaxed mb-6">
            {systems[1].tagline}
          </p>

          <!-- Biaya Highlight -->
          <div class="bg-cream-50/70 rounded-xl p-4 sm:p-5 border border-stone-200 mb-6">
            <div class="flex items-baseline gap-2 mb-1">
              <span class="font-heading font-bold text-3xl sm:text-4xl text-warmtext-dark">
                {systems[1].biaya}
              </span>
            </div>
            <p class="text-xs text-warmtext-muted leading-relaxed">
              {systems[1].biayaDetail}
            </p>
          </div>

          <!-- Cocok Untuk -->
          <div class="mb-6 pb-6 border-b border-stone-200/80 text-xs sm:text-sm text-warmtext-dark">
            <p class="font-semibold text-warmtext-dark mb-1">Keunggulan Utama:</p>
            <p class="text-warmtext-muted leading-relaxed">{systems[1].keunggulan} {systems[1].cocokUntuk}</p>
          </div>

          <!-- Benefit Tiap Foto -->
          <div class="mb-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-warmtext-dark mb-3">
              {systems[1].checklistTitle}
            </p>
            <ul class="text-xs sm:text-sm text-warmtext-muted space-y-2.5">
              {systems[1].checklist.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-stone-100 text-stone-700 flex items-center justify-center shrink-0 mt-0.5">
                    <Icon name="check" class="w-3 h-3" />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Media Promosi -->
          <div class="p-3.5 rounded-lg bg-stone-50 border border-stone-200/70 text-xs text-stone-700 leading-relaxed mb-6">
            <strong class="font-semibold block mb-0.5">Media Promosi:</strong>
            {systems[1].mediaPromosi}
          </div>
        </div>

        <!-- Tombol Action -->
        <div class="pt-4 border-t border-stone-200">
          <a
            href={getWhatsAppUrl(systems[1].waMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-sm bg-stone-900 hover:bg-stone-800 text-white shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-2"
          >
            <Icon name="message-circle" class="w-4 h-4 text-white" />
            <span>{systems[1].buttonText}</span>
          </a>
        </div>
      </div>

    </div>

    <!-- TABEL PERBANDINGAN SINGKAT (ALLU Style Architecture) -->
    <div class="fade-up-element pt-8 border-t border-stone-200/80 font-body">
      <div class="mb-6 text-center sm:text-left">
        <h4 class="font-heading font-semibold text-2xl sm:text-3xl text-warmtext-dark tracking-tight">
          Perbandingan Singkat Kedua Sistem
        </h4>
        <p class="text-xs sm:text-sm text-warmtext-muted mt-1">
          Tabel ringkas pembagian tugas dan fasilitas yang kamu dapatkan di tiap sistem.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-stone-200">
        <table class="w-full text-left border-collapse min-w-[620px] text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-stone-200 bg-cream-50/80 text-warmtext-dark">
              <th class="py-3.5 px-4 font-semibold w-1/3">Tugas / Fasilitas</th>
              <th class="py-3.5 px-4 font-bold text-rosebrand-700 bg-rosebrand-50/50 w-1/3 border-l border-r border-rosebrand-200/70">
                Sistem Terima Beres ⭐
              </th>
              <th class="py-3.5 px-4 font-semibold text-warmtext-dark w-1/3">
                Sistem Titip Jual Biasa
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200/70 bg-white">
            {comparisons.map((row) => (
              <tr class="hover:bg-stone-50/50 transition-colors">
                <td class="py-3 px-4 font-medium text-warmtext-dark">
                  {row.fitur}
                </td>
                <td class="py-3 px-4 font-semibold text-rosebrand-900 bg-rosebrand-50/20 border-l border-r border-rosebrand-200/40">
                  {row.terimaBeres}
                </td>
                <td class="py-3 px-4 text-warmtext-muted">
                  {row.titipBiasa}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Info Pembayaran (Tanpa Rekening / QRIS di web sesuai aturan) -->
      <div class="mt-6 p-4 rounded-xl bg-cream-50 border border-blush-200/70 text-xs text-warmtext-muted flex items-start gap-2.5">
        <span class="text-rosebrand-600 text-sm mt-0.5">💳</span>
        <div>
          <strong class="text-warmtext-dark font-medium block">{siteConfig.paymentNote}</strong>
          <span>Nomor rekening resmi dan instruksi pembayaran akan dikirimkan langsung oleh Kak Izah saat konfirmasi lewat WhatsApp.</span>
        </div>
      </div>
    </div>

  </div>
</section>
