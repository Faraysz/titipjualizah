---
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

const waCommissionUrl = getWhatsAppUrl(siteConfig.commissionWaMessage);
---

<section id="komisi" class="py-16 sm:py-24 bg-cream-50 border-b border-stone-200/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading (ALLU Inspired: Clean & Editorial) -->
    <div class="max-w-2xl mb-14 sm:mb-18 fade-up-element text-center sm:text-left">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Skema Transparan
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        Biaya &amp; Skema Komisi
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Sistem bagi hasil yang adil. Tidak ada biaya sewa etalase di awal. Komisi hanya dipotong saat barang berhasil terjual.
      </p>
    </div>

    <!-- Tiered Pricing Grid (ALLU Style: Clean, Slim Borders, No AI Slop Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10 mb-14 font-body">
      {siteConfig.commissionTiers.map((tier, idx) => {
        const isMiddle = idx === 1;
        return (
          <div
            class={`fade-up-element pt-6 border-t-2 flex flex-col justify-between ${
              isMiddle
                ? 'border-rosebrand-600'
                : 'border-stone-300'
            }`}
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-rosebrand-600">
                  {tier.category}
                </span>
                {isMiddle && (
                  <span class="text-[10px] uppercase font-bold tracking-wider text-rosebrand-700 bg-blush-100 px-2 py-0.5 rounded">
                    Populer
                  </span>
                )}
              </div>

              <!-- Rate Display (Clean Serif & Sans) -->
              <div class="mb-4">
                <span class="font-heading font-bold text-3xl sm:text-4xl text-warmtext-dark block">
                  {tier.rate}
                </span>
                <span class="text-xs text-warmtext-muted block mt-0.5">
                  dari harga deal penjualan
                </span>
              </div>

              <p class="text-xs sm:text-sm text-warmtext-muted mb-6 leading-relaxed">
                {tier.description}
              </p>

              <!-- Features checklist -->
              <ul class="text-xs text-warmtext-muted space-y-2.5 mb-8">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2">
                    <Icon name="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action Link -->
            <div class="pt-4 border-t border-stone-200">
              <a
                href={waCommissionUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-rosebrand-600 hover:text-rosebrand-700"
              >
                <span>Tanya detail via WA</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Minimal Assurance Note -->
    <div class="pt-6 border-t border-stone-200/80 text-xs sm:text-sm text-warmtext-muted font-body fade-up-element">
      <span>💡 <strong>Garansi:</strong> Jika barang titipan tidak berhasil terjual, kamu sama sekali <strong class="text-warmtext-dark">tidak dikenakan komisi apa pun</strong>.</span>
    </div>

  </div>
</section>
