---
import { Image } from 'astro:assets';
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';
import logoImg from '../assets/logo.png';

const waUrl = getWhatsAppUrl();
---

<!-- Final Action Banner (Editorial Clean Look, Cormorant Garamond) -->
<section class="py-20 sm:py-28 bg-rosebrand-600 text-white relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10 fade-up-element font-body">
    <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-blush-200 mb-3">
      Mulai Sekarang
    </p>
    
    <h2 class="font-heading font-semibold text-4xl sm:text-6xl tracking-tight mb-6 text-white leading-[1.08]">
      Lemari Penuh? Saatnya Decluttering &amp; Jadi Cuan Bersama Izah.
    </h2>
    
    <p class="text-blush-100 text-sm sm:text-lg max-w-xl mx-auto mb-10 leading-relaxed font-normal">
      Kirimkan foto baju, tas, sepatu, hijab, atau skincare yang ingin kamu jual. Kak Izah siap bantu urus sampai laku ke pemilik baru.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-10 py-4 rounded-full text-base font-semibold bg-white text-rosebrand-700 hover:bg-cream-50 shadow-sm hover:scale-102 active:scale-98 transition-all flex items-center justify-center gap-3 font-body tracking-wide"
      >
        <Icon name="message-circle" class="w-5 h-5 text-rosebrand-700" />
        <span>Chat WhatsApp Kak Izah Sekarang</span>
      </a>
    </div>
  </div>
</section>

<!-- Main Footer (Warna Hangat Lembut & Elegan - BUKAN Hitam) -->
<footer class="bg-cream-100 text-warmtext-muted py-14 sm:py-18 border-t border-stone-200/80 font-body text-xs sm:text-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 sm:gap-12 mb-12">
      
      <!-- Brand & Bio with Official Transparent Logo -->
      <div class="md:col-span-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-11 flex items-center justify-center">
            <Image
              src={logoImg}
              alt={`Logo Resmi ${siteConfig.brandName}`}
              class="h-10 w-auto object-contain drop-shadow-sm"
            />
          </div>
          <div>
            <span class="font-heading font-bold text-2xl sm:text-3xl text-warmtext-dark block leading-none">
              {siteConfig.brandName}
            </span>
            <span class="text-[10px] font-medium text-rosebrand-600 tracking-wider uppercase block mt-1 font-body">
              by {siteConfig.ownerName}
            </span>
          </div>
        </div>
        <p class="text-warmtext-muted max-w-md leading-relaxed mb-4 font-normal">
          Layanan titip jual khusus barang wanita (baju, celana, tas, jam tangan, sepatu &amp; sandal, hijab, skincare &amp; makeup) oleh <strong>{siteConfig.ownerName}</strong>. Membantu perempuan merapikan lemari dan mencairkan barang preloved secara aman, praktis, dan transparan.
        </p>
        <p class="text-xs text-warmtext-soft">
          Semua transaksi dan konsultasi resmi dilakukan via WhatsApp.
        </p>
      </div>

      <!-- Quick Nav Links -->
      <div class="md:col-span-3">
        <h4 class="font-body font-semibold text-xs text-warmtext-dark uppercase tracking-wider mb-4">
          Navigasi Halaman
        </h4>
        <ul class="space-y-2.5">
          <li><a href="#cara-kerja" class="text-warmtext-muted hover:text-rosebrand-600 transition-colors">Cara Kerja</a></li>
          <li><a href="#keuntungan" class="text-warmtext-muted hover:text-rosebrand-600 transition-colors">Keuntungan</a></li>
          <li><a href="#kategori" class="text-warmtext-muted hover:text-rosebrand-600 transition-colors">7 Kategori Barang</a></li>
          <li><a href="#komisi" class="text-warmtext-muted hover:text-rosebrand-600 transition-colors">Skema Komisi</a></li>
          <li><a href="#terjual" class="text-warmtext-muted hover:text-rosebrand-600 transition-colors">Barang Terjual</a></li>
          <li><a href="#testimoni" class="text-warmtext-muted hover:text-rosebrand-600 transition-colors">Testimoni Asli</a></li>
          <li><a href="#faq" class="text-warmtext-muted hover:text-rosebrand-600 transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Official Contact -->
      <div class="md:col-span-3">
        <h4 class="font-body font-semibold text-xs text-warmtext-dark uppercase tracking-wider mb-4">
          Kontak Resmi
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-warmtext-dark hover:text-emerald-600 transition-colors font-medium"
            >
              <Icon name="message-circle" class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>WhatsApp: {siteConfig.whatsappDisplay}</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-warmtext-dark hover:text-rosebrand-600 transition-colors font-medium"
            >
              <Icon name="instagram" class="w-4 h-4 text-rosebrand-600 shrink-0" />
              <span>Instagram: {siteConfig.instagramHandle}</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-warmtext-soft text-xs pt-1">
            <Icon name="truck" class="w-4 h-4 text-warmtext-soft shrink-0" />
            <span>Pengiriman aman seluruh Indonesia</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright bar -->
    <div class="pt-8 border-t border-stone-200/80 flex flex-col sm:flex-row items-center justify-between text-xs text-warmtext-soft gap-4">
      <p>&copy; 2026 {siteConfig.brandName} by {siteConfig.ownerName}. All rights reserved.</p>
      <p class="text-warmtext-muted">
        Khusus barang wanita original &amp; preloved berkualitas.
      </p>
    </div>
  </div>
</footer>
