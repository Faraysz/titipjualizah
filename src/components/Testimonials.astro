---
import { Image } from 'astro:assets';
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';

// Import gambar barang dari src/assets/barang/
import barang1 from '../assets/barang/barang-1.svg';
import barang2 from '../assets/barang/barang-2.svg';
import barang3 from '../assets/barang/barang-3.svg';
import barang4 from '../assets/barang/barang-4.svg';
import barang5 from '../assets/barang/barang-5.svg';
import barang6 from '../assets/barang/barang-6.svg';

const barangImages: Record<string, ImageMetadata> = {
  'barang-1': barang1,
  'barang-2': barang2,
  'barang-3': barang3,
  'barang-4': barang4,
  'barang-5': barang5,
  'barang-6': barang6,
};

// Import screenshot chat asli dari src/assets/testimoni/
import testi1 from '../assets/testimoni/testi-1.jpg';
import testi2 from '../assets/testimoni/testi-2.jpg';

const testiImages: Record<string, ImageMetadata> = {
  'testi-1': testi1,
  'testi-2': testi2,
};
---

<section id="terjual" class="py-16 sm:py-24 bg-white border-b border-blush-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading: Galeri Terjual (Cormorant Garamond) -->
    <div class="text-center max-w-2xl mx-auto mb-14 fade-up-element">
      <span class="text-rosebrand-600 font-semibold text-xs tracking-widest uppercase mb-2 block font-body">
        Galeri Transaksi
      </span>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-4">
        Contoh Barang yang Pernah Terjual
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Beberapa barang titipan cewek-cewek yang berhasil laku cepat dengan harga pasaran terbaik.
      </p>
    </div>

    <!-- Gallery Grid with Uniform 1:1 Aspect Ratio (DM Sans font-body) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-24 font-body">
      {siteConfig.soldGallery.map((item) => {
        const img = barangImages[item.id];
        return (
          <div class="fade-up-element bg-cream-50 rounded-3xl overflow-hidden border border-blush-100 flex flex-col justify-between group hover:border-blush-300 hover:shadow-soft-hover transition-all duration-300">
            <div>
              <!-- Uniform aspect ratio (1:1 square) -->
              <div class="relative aspect-square overflow-hidden bg-white">
                {img && (
                  <Image
                    src={img}
                    alt={item.alt}
                    class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-300"
                  />
                )}
                
                <span class="absolute top-4 left-4 bg-rosebrand-600 text-white font-bold text-[11px] uppercase tracking-wider px-3 py-1 rounded-full shadow-sm font-body">
                  TERJUAL
                </span>
              </div>

              <!-- Item Information -->
              <div class="p-6">
                <span class="text-xs font-semibold text-rosebrand-600 block mb-1">
                  {item.category}
                </span>
                <h3 class="font-heading font-bold text-2xl text-warmtext-dark mb-1">
                  {item.title}
                </h3>
                <p class="text-xs text-warmtext-muted mb-2">
                  {item.condition}
                </p>
                <span class="text-[11px] text-warmtext-soft block italic">
                  {item.caption}
                </span>
              </div>
            </div>

            <div class="px-6 py-4 bg-white border-t border-blush-100/80 flex items-center justify-between text-xs">
              <div>
                <span class="text-[10px] text-warmtext-soft block">Harga Laku:</span>
                <span class="font-body font-bold text-rosebrand-600 text-sm">{item.priceSold}</span>
              </div>
              <span class="text-[11px] font-medium text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100">
                {item.durationSold}
              </span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Section Heading: Testimoni Chat WhatsApp Asli (Cormorant Garamond) -->
    <div id="testimoni" class="text-center max-w-2xl mx-auto mb-14 fade-up-element pt-4">
      <span class="text-rosebrand-600 font-semibold text-xs tracking-widest uppercase mb-2 block font-body">
        Testimoni Nyata
      </span>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-4">
        Cerita Mereka yang Pernah Titip Jual
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Tangkapan layar obrolan asli dari teman-teman penitip setelah barangnya berhasil terjual di Titip Jual Izah.
      </p>
    </div>

    <!-- Testimonial Asli Grid (2 Kolom Lebar & Proporsional Sesuai Screenshot Asli) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto font-body">
      {siteConfig.testimonials.map((testi) => {
        const img = testiImages[testi.id];
        return (
          <div class="fade-up-element flex flex-col items-center">
            <!-- Frame Story / Chat Asli -->
            <div class="w-full rounded-3xl overflow-hidden bg-white border border-blush-200 shadow-soft p-3 hover:shadow-soft-hover transition-all">
              <div class="rounded-2xl overflow-hidden bg-cream-50 relative aspect-[9/16] max-h-[580px]">
                {img && (
                  <Image
                    src={img}
                    alt={testi.alt}
                    class="w-full h-full object-cover object-top"
                  />
                )}
              </div>
            </div>

            <!-- Customer Caption -->
            <div class="mt-4 text-center max-w-sm">
              <h4 class="font-heading font-bold text-warmtext-dark text-xl sm:text-2xl">
                {testi.senderName}
              </h4>
              <p class="text-xs text-rosebrand-600 font-medium mt-0.5">
                {testi.itemSold}
              </p>
              <p class="text-xs text-warmtext-muted mt-2 italic leading-relaxed">
                "{testi.message}"
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
