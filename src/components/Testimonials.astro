---
import { Image } from 'astro:assets';
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';

// Import foto produk preloved asli dari internet/unsplash
import barang1 from '../assets/barang/barang-1.jpg';
import barang2 from '../assets/barang/barang-2.jpg';
import barang3 from '../assets/barang/barang-3.jpg';
import barang4 from '../assets/barang/barang-4.jpg';
import barang5 from '../assets/barang/barang-5.jpg';
import barang6 from '../assets/barang/barang-6.jpg';

const barangImages: Record<string, ImageMetadata> = {
  'barang-1': barang1,
  'barang-2': barang2,
  'barang-3': barang3,
  'barang-4': barang4,
  'barang-5': barang5,
  'barang-6': barang6,
};

// Import screenshot chat testimoni asli
import testi1 from '../assets/testimoni/testi-1.jpg';
import testi2 from '../assets/testimoni/testi-2.jpg';

const testiImages: Record<string, ImageMetadata> = {
  'testi-1': testi1,
  'testi-2': testi2,
};
---

<section id="terjual" class="py-16 sm:py-24 bg-white border-b border-stone-200/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading: Galeri Terjual (Editorial ALLU Style) -->
    <div class="max-w-2xl mb-12 sm:mb-16 fade-up-element text-center sm:text-left">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Riwayat Penjualan
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        Contoh Barang yang Pernah Terjual
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Koleksi barang titipan yang berhasil laku terjual ke pemilik baru dengan harga pasaran terbaik.
      </p>
    </div>

    <!-- Gallery Grid (Editorial Butik Look: Real Photos, No Thick Card Borders) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8 mb-24 font-body">
      {siteConfig.soldGallery.map((item) => {
        const img = barangImages[item.id];
        return (
          <div class="fade-up-element group block">
            <!-- Product Real Photo Frame -->
            <div class="aspect-square w-full overflow-hidden rounded-xl bg-stone-100 relative mb-3">
              {img && (
                <Image
                  src={img}
                  alt={item.alt}
                  class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-500 ease-out"
                />
              )}
              
              <!-- Subtle Clean Sold Tag -->
              <span class="absolute top-3 left-3 bg-warmtext-dark/90 backdrop-blur-sm text-white font-medium text-[10px] sm:text-[11px] uppercase tracking-wider px-2.5 py-0.5 rounded">
                TERJUAL
              </span>
            </div>

            <!-- Product Info Under Photo (Clean, Professional) -->
            <div>
              <span class="text-[11px] uppercase tracking-wider text-rosebrand-700 font-semibold block mb-0.5">
                {item.category}
              </span>
              <h3 class="font-heading font-bold text-lg sm:text-xl text-warmtext-dark leading-snug">
                {item.title}
              </h3>
              <p class="text-xs text-warmtext-muted line-clamp-1 mt-0.5 mb-1.5 font-normal">
                {item.condition}
              </p>
              <div class="flex items-center justify-between text-xs pt-1 border-t border-stone-100">
                <span class="font-bold text-rosebrand-700 text-sm">{item.priceSold}</span>
                <span class="text-[11px] text-emerald-700 font-medium">{item.durationSold}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Section Heading: Testimoni Asli (Frameless / No AI Card) -->
    <div id="testimoni" class="max-w-2xl mb-12 sm:mb-16 fade-up-element text-center sm:text-left pt-6 border-t border-stone-200/80">
      <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-2 font-body">
        Testimoni Penitip
      </p>
      <h2 class="font-heading font-semibold text-3xl sm:text-5xl text-warmtext-dark tracking-tight mb-3">
        Cerita Nyata dari Teman-Teman Penitip
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed font-body">
        Tangkapan layar obrolan asli dan testimoni kepuasan setelah barang berhasil terjual di Titip Jual Izah.
      </p>
    </div>

    <!-- Testimonial Grid (Natural Story/Chat Presentation: GAK PAKAI CARD) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 sm:gap-14 max-w-4xl mx-auto font-body">
      {siteConfig.testimonials.map((testi) => {
        const img = testiImages[testi.id];
        return (
          <div class="fade-up-element flex flex-col items-center sm:items-start">
            <!-- Natural Story Image (No Nested Card Frame, Clean Minimal Shadow) -->
            <div class="w-full max-w-[360px] mx-auto overflow-hidden rounded-2xl shadow-sm border border-stone-200/80 aspect-[9/16] bg-stone-100 mb-4">
              {img && (
                <Image
                  src={img}
                  alt={testi.alt}
                  class="w-full h-full object-cover object-top"
                />
              )}
            </div>

            <!-- Customer Notes (Clean Typography, No Card Wrapping) -->
            <div class="text-center sm:text-left w-full max-w-[360px] mx-auto px-1">
              <h4 class="font-heading font-bold text-xl text-warmtext-dark">
                {testi.senderName}
              </h4>
              <p class="text-xs text-rosebrand-600 font-medium">
                {testi.itemSold}
              </p>
              <p class="text-xs text-warmtext-muted mt-2 italic leading-relaxed">
                "{testi.message}"
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
