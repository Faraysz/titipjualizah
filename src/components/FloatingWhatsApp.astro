---
import { getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

const waUrl = getWhatsAppUrl();
---

<div
  id="wa-floating-container"
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex items-end flex-col gap-2 transition-all duration-300"
>
  
  <!-- Pop-in Tooltip Bubble (Ramping & Halus) -->
  <div
    id="wa-floating-bubble"
    class="bg-white text-warmtext-dark text-[11px] font-medium py-1.5 px-3 rounded-2xl shadow-soft border border-blush-200 flex items-center gap-1.5 max-w-[190px] opacity-0 translate-y-2 pointer-events-none transition-all duration-300 font-body"
  >
    <span>Mau titip barang? Chat yuk!</span>
    <button
      type="button"
      id="close-wa-bubble"
      aria-label="Tutup sapaan"
      class="text-warmtext-soft hover:text-warmtext-dark text-xs font-bold ml-1 focus:outline-none"
    >
      &times;
    </button>
  </div>

  <!-- Floating WhatsApp Button (Ramping, Clean & Elegan ala Allu) -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp Kak Izah"
    class="wa-float-btn w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center text-white bg-[#25d366] hover:bg-[#20ba5a] shadow-md hover:shadow-lg hover:scale-105 active:scale-95 transition-all"
  >
    <Icon name="message-circle" class="w-5 h-5 sm:w-6 sm:h-6 text-white" />
  </a>

</div>

<style>
  /* Slow subtle pulse animation (Halus & Tidak Mengganggu) */
  @keyframes slowWaPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  .wa-float-btn {
    animation: slowWaPulse 3.5s infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float-btn {
      animation: none !important;
    }
  }
</style>

<script>
  // Show bubble smoothly after 3 seconds
  setTimeout(() => {
    const bubble = document.getElementById('wa-floating-bubble');
    if (bubble) {
      bubble.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
      bubble.classList.add('opacity-100', 'translate-y-0');
    }
  }, 3000);

  // Close bubble button handler
  document.getElementById('close-wa-bubble')?.addEventListener('click', () => {
    const bubble = document.getElementById('wa-floating-bubble');
    if (bubble) {
      bubble.style.display = 'none';
    }
  });

  // Sembunyikan tombol WA mengambang saat Section Penutup Izah terlihat (agar tidak ada 2 tombol WA bertumpuk)
  const closingSection = document.getElementById('penutup-izah');
  const floatingContainer = document.getElementById('wa-floating-container');

  if (closingSection && floatingContainer) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            floatingContainer.classList.add('opacity-0', 'pointer-events-none', 'translate-y-6', 'scale-95');
          } else {
            floatingContainer.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-6', 'scale-95');
          }
        });
      },
      {
        root: null,
        threshold: 0.1, // Trigger saat 10% section penutup terlihat
      }
    );

    observer.observe(closingSection);
  }
</script>
