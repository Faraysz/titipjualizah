---
import { getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

const waUrl = getWhatsAppUrl();
---

<div
  id="wa-floating-container"
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex items-center gap-2 transition-all duration-300"
>
  
  <!-- Pop-in Tooltip Bubble (Mungil, Sejajar di Kiri Tombol, Tidak Menutupi Teks Konten) -->
  <div
    id="wa-floating-bubble"
    class="bg-white/95 backdrop-blur-sm text-warmtext-dark text-[10px] font-medium py-1 px-2.5 rounded-full shadow-soft border border-blush-200 flex items-center gap-1.5 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 font-body shrink-0"
  >
    <span>Chat Kak Izah yuk!</span>
    <button
      type="button"
      id="close-wa-bubble"
      aria-label="Tutup sapaan"
      class="text-warmtext-soft hover:text-warmtext-dark text-xs font-bold focus:outline-none leading-none px-0.5"
    >
      &times;
    </button>
  </div>

  <!-- Floating WhatsApp Button (Ramping, Clean & Elegan) -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp Kak Izah"
    class="wa-float-btn w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center text-white bg-[#25d366] hover:bg-[#20ba5a] shadow-md hover:shadow-lg hover:scale-105 active:scale-95 transition-all shrink-0"
  >
    <Icon name="message-circle" class="w-5 h-5 sm:w-6 sm:h-6 text-white" />
  </a>

</div>

<style>
  /* Slow subtle pulse animation (Halus & Tidak Mengganggu) */
  @keyframes slowWaPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  .wa-float-btn {
    animation: slowWaPulse 3.5s infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float-btn {
      animation: none !important;
    }
  }
</style>

<script>
  const bubble = document.getElementById('wa-floating-bubble');
  let bubbleShown = false;

  const hideBubble = () => {
    if (bubble) {
      bubble.classList.remove('opacity-100', 'translate-x-0');
      bubble.classList.add('opacity-0', 'translate-x-2', 'pointer-events-none');
      setTimeout(() => {
        bubble.style.display = 'none';
      }, 300);
    }
  };

  // Tampilkan bubble hanya sekali setelah 3.5 detik jika belum di-scroll
  const timer = setTimeout(() => {
    if (bubble && !bubbleShown) {
      bubbleShown = true;
      bubble.classList.remove('opacity-0', 'translate-x-2', 'pointer-events-none');
      bubble.classList.add('opacity-100', 'translate-x-0');
    }
  }, 3500);

  // Otomatis hilangkan bubble saat pengguna mulai scroll halaman
  window.addEventListener(
    'scroll',
    () => {
      clearTimeout(timer);
      hideBubble();
    },
    { once: true, passive: true }
  );

  // Close bubble button handler
  document.getElementById('close-wa-bubble')?.addEventListener('click', (e) => {
    e.stopPropagation();
    hideBubble();
  });

  // Sembunyikan seluruh tombol WA mengambang saat Section Penutup Izah terlihat
  const closingSection = document.getElementById('penutup-izah');
  const floatingContainer = document.getElementById('wa-floating-container');

  if (closingSection && floatingContainer) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            floatingContainer.classList.add('opacity-0', 'pointer-events-none', 'translate-y-6', 'scale-95');
          } else {
            floatingContainer.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-6', 'scale-95');
          }
        });
      },
      {
        root: null,
        threshold: 0.1,
      }
    );

    observer.observe(closingSection);
  }
</script>
