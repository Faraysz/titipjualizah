---
import Icon from './Icon.astro';

const benefits = [
  {
    title: 'Gak Perlu Repot Foto & Edit Cantik',
    desc: 'Kamu gak usah sewa studio atau pusing lighting. Kirimkan foto apa adanya, Kak Izah bantu poles visual dan deskripsi agar rapi dan meyakinkan pembeli.',
    icon: 'camera' as const,
  },
  {
    title: 'Bebas Drama Balas Ratusan Chat & Nego Sadis',
    desc: 'Capek menghadapi orang yang cuma tanya-tanya, nawar separuh harga, lalu hilang tanpa kabar? Biar Kak Izah yang hadapi negosiasi dengan tegas dan ramah.',
    icon: 'message-circle' as const,
  },
  {
    title: 'Tanpa Ribet Packing & Ekspedisi',
    desc: 'Gak perlu beli bubble wrap berkilo-kilo atau keluar rumah panas-panasan kirim barang. Pengemasan dan pengiriman kami bantu tangani secara aman.',
    icon: 'truck' as const,
  },
  {
    title: 'Skema Komisi Terbuka Tanpa Potongan Siluman',
    desc: 'Semua persentase komisi disepakati bersama sejak awal sebelum barang dipromosikan. Tidak ada biaya pendaftaran atau denda bila barang belum laku.',
    icon: 'tag' as const,
  },
  {
    title: 'Amanah & Privasi Penitip Terjaga',
    desc: 'Bisa 100% anonim. Akun pribadi atau kontak kamu tidak akan dipublikasikan ke pembeli. Dana penjualan langsung masuk ke rekening pribadi kamu.',
    icon: 'shield-check' as const,
  },
  {
    title: 'Pasar Terfokus Sesama Cewek',
    desc: 'Katalog dipromosikan langsung ke jaringan dan audiens wanita yang memang aktif mencari outfit, tas branded, dan aksesoris preloved original.',
    icon: 'user-check' as const,
  },
];
---

<section id="keuntungan" class="py-16 sm:py-24 bg-cream-50 border-b border-blush-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-14 text-center sm:text-left fade-up-element">
      <span class="text-rosebrand-600 font-semibold text-xs tracking-widest uppercase mb-2 block">
        Kenapa Titip Jual?
      </span>
      <h2 class="font-heading font-bold text-2xl sm:text-4xl text-warmtext-dark tracking-tight mb-4">
        Keuntungan Titip Barang ke Kak Izah
      </h2>
      <p class="text-warmtext-muted text-sm sm:text-base leading-relaxed">
        Jual barang preloved sendiri seringkali melelahkan dan menyita waktu. Titipkan ke Izah, kamu tinggal terima bersih hasilnya.
      </p>
    </div>

    <!-- Varied Layout: 2-Column Clean Cards with Clear Hierarchy -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map((item) => (
        <div class="fade-up-element bg-white rounded-3xl p-7 border border-blush-100/90 shadow-soft hover:shadow-soft-hover transition-all">
          <div class="w-11 h-11 rounded-2xl bg-blush-50 border border-blush-200/60 flex items-center justify-center text-rosebrand-600 mb-5">
            <Icon name={item.icon} class="w-5 h-5 text-rosebrand-600" />
          </div>

          <h3 class="font-heading font-bold text-lg text-warmtext-dark mb-2.5">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-warmtext-muted leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

