---
import { Image } from 'astro:assets';
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';
import heroImg from '../assets/hero/hero-showcase.jpg';

const waUrl = getWhatsAppUrl();
---

<section class="relative pt-12 pb-16 sm:pt-20 sm:pb-28 border-b border-stone-200/70 bg-cream-50 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Editorial Headline & Copywriting -->
      <div class="lg:col-span-7 text-center lg:text-left fade-up-element">
        
        <!-- Subtle Eyebrow (Clean, No Pill Box) -->
        <p class="text-xs sm:text-sm font-medium tracking-widest uppercase text-rosebrand-700 mb-4 font-body">
          Layanan Titip Jual Preloved Wanita
        </p>

        <!-- Main Headline (Cormorant Garamond) -->
        <h1 class="font-heading font-semibold text-4xl sm:text-6xl lg:text-[68px] text-warmtext-dark tracking-tight leading-[1.08] mb-6">
          Titip jual barang cewekmu, biar <span class="font-normal italic text-rosebrand-600">Izah yang urus</span> sampai laku.
        </h1>

        <!-- Natural Scope Explanation (DM Sans) -->
        <p class="text-base sm:text-lg text-warmtext-muted mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal font-body">
          Ubah koleksi baju, tas, sepatu, hijab, sampai skincare yang menumpuk di lemari jadi uang tunai tanpa repot foto ulang, balas ratusan chat, atau COD.
        </p>

        <!-- CTA Action Button -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10 font-body">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-9 py-4 rounded-full text-base font-medium bg-rosebrand-600 hover:bg-rosebrand-700 text-white shadow-sm hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3 tracking-wide"
          >
            <Icon name="message-circle" class="w-5 h-5 text-white" />
            <span>Chat WhatsApp Kak Izah</span>
          </a>
        </div>

        <!-- Trust List (ALLU Style: Clean, Subtle Divider) -->
        <div class="pt-6 border-t border-stone-200/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 sm:gap-8 text-xs sm:text-sm text-warmtext-muted font-body">
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Konsultasi gratis</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Tanpa biaya di muka</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Komisi transparan</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Real Editorial Photo (No Nested Card Bloat) -->
      <div class="lg:col-span-5 fade-up-element">
        <div class="relative mx-auto max-w-md">
          <!-- Real High-Fashion Editorial Photo -->
          <div class="overflow-hidden rounded-2xl aspect-[4/5] shadow-sm bg-stone-100">
            <Image
              src={heroImg}
              alt="Koleksi fashion preloved wanita di Titip Jual Izah"
              loading="eager"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Discrete Floating Caption (Clean, Editorial) -->
          <div class="mt-3 flex items-center justify-between text-xs text-warmtext-muted font-body px-1">
            <span class="tracking-wide">Titip Jual Preloved Terkurasi</span>
            <span class="text-rosebrand-600 font-medium">by Kak Izah</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
