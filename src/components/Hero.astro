---
import { Image } from 'astro:assets';
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';
import heroImg from '../assets/hero/hero-showcase.jpg';

const waUrl = getWhatsAppUrl();
---

<section class="relative pt-4 pb-12 sm:pt-6 sm:pb-20 border-b border-stone-200/70 bg-cream-50 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- Left Column: Editorial Headline & Copywriting -->
      <div class="lg:col-span-7 text-center lg:text-left fade-up-element">
        
        <!-- Main Headline (Cormorant Garamond) -->
        <h1 class="font-heading font-semibold text-4xl sm:text-6xl lg:text-[62px] text-warmtext-dark tracking-tight leading-[1.08] mb-5">
          Lemari Penuh Jadi Uang? <span class="font-normal italic text-rosebrand-600">Biar Izah yang Urus</span> Sampai Laku!
        </h1>

        <!-- Scope Explanation Fokus Pakaian & 2 Sistem (DM Sans) -->
        <p class="text-base sm:text-lg text-warmtext-muted mb-7 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal font-body">
          Jasa titip jual baju &amp; fashion cewek terpercaya. Pilih sistem <strong>Terima Beres</strong> (admin urus foto, ukur, packing wangi, sampai kirim) atau sistem <strong>Titip Jual Biasa</strong> (hemat biaya mulai Rp5.000/foto, barang tetap di rumahmu).
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 mb-8 font-body">
          <a
            href="#pilih-sistem"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full text-base font-semibold bg-rosebrand-600 hover:bg-rosebrand-700 text-white shadow-btn hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-2.5 tracking-wide"
          >
            <span>Pilih Sistem Titip Jual</span>
            <Icon name="arrow-right" class="w-4 h-4 text-white" />
          </a>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-3.5 rounded-full text-base font-medium bg-white hover:bg-cream-100 text-warmtext-dark border border-stone-200/90 hover:border-rosebrand-300 shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-2.5"
          >
            <Icon name="message-circle" class="w-4 h-4 text-emerald-600" />
            <span>Chat WhatsApp</span>
          </a>
        </div>

        <!-- Trust List (ALLU Style: Clean, Subtle Divider) -->
        <div class="pt-5 border-t border-stone-200/80 flex flex-wrap items-center justify-center lg:justify-start gap-5 sm:gap-7 text-xs sm:text-sm text-warmtext-muted font-body">
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-rosebrand-600 shrink-0" />
            <span>Terima Beres Rp7.000/baju</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Titip Biasa Rp5.000/foto</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-rosebrand-600 shrink-0" />
            <span>Promosi di 4 Media Sosial</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Real Editorial Photo -->
      <div class="lg:col-span-5 fade-up-element">
        <div class="relative mx-auto max-w-md">
          <div class="overflow-hidden rounded-2xl aspect-[4/5] shadow-sm bg-stone-100">
            <Image
              src={heroImg}
              alt="Koleksi fashion preloved wanita di Titip Jual Izah"
              loading="eager"
              class="w-full h-full object-cover"
            />
          </div>

          <div class="mt-2.5 flex items-center justify-between text-xs text-warmtext-muted font-body px-1">
            <span class="tracking-wide">Titip Jual Preloved Terkurasi</span>
            <span class="text-rosebrand-600 font-medium">by Kak Izah</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
