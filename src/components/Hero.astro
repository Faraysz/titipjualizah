---
import { Image } from 'astro:assets';
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';
import heroShowcase from '../assets/hero/hero-showcase.svg';

const waUrl = getWhatsAppUrl();
---

<section class="relative pt-10 pb-16 sm:pt-16 sm:pb-24 border-b border-blush-100 overflow-hidden bg-cream-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copywriting & CTA -->
      <div class="lg:col-span-7 text-center lg:text-left fade-up-element">
        
        <!-- Trust Badge (Spesifik & Elegan ala Allu) -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blush-50 border border-blush-200 text-rosebrand-700 text-xs sm:text-sm font-medium mb-6">
          <Icon name="sparkles" class="w-4 h-4 text-rosebrand-600" />
          <span>Titip Jual Barang Wanita Terpercaya</span>
        </div>

        <!-- Main Headline (Cormorant Garamond 600 + Italic 500 Accent) -->
        <h1 class="font-heading font-semibold text-4xl sm:text-6xl lg:text-[64px] text-warmtext-dark tracking-tight leading-[1.12] mb-6">
          Titip jual barang cewekmu, biar <span class="font-normal italic text-rosebrand-600">Izah yang urus</span> sampai laku!
        </h1>

        <!-- Natural Scope Explanation (DM Sans) -->
        <p class="text-base sm:text-lg text-warmtext-muted mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Ubah koleksi baju, tas, sepatu, hijab, sampai skincare yang menumpuk di lemari jadi uang tunai tanpa perlu ribet foto ulang, balas ratusan chat, atau COD.
        </p>

        <!-- Main Action Button (DM Sans 600) -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-full text-base font-semibold bg-rosebrand-600 hover:bg-rosebrand-700 text-white shadow-btn hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3 font-body"
          >
            <Icon name="message-circle" class="w-5 h-5 text-white" />
            <span>Chat WhatsApp Kak Izah</span>
          </a>
        </div>

        <!-- Realistic Checklist (DM Sans) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-blush-100 text-xs sm:text-sm text-warmtext-muted">
          <div class="flex items-center justify-center lg:justify-start gap-2">
            <Icon name="check" class="w-4 h-4 text-rosebrand-600 shrink-0" />
            <span>Konsultasi gratis via WA</span>
          </div>
          <div class="flex items-center justify-center lg:justify-start gap-2">
            <Icon name="check" class="w-4 h-4 text-rosebrand-600 shrink-0" />
            <span>Tanpa biaya di muka</span>
          </div>
          <div class="flex items-center justify-center lg:justify-start gap-2">
            <Icon name="check" class="w-4 h-4 text-rosebrand-600 shrink-0" />
            <span>Komisi transparan</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase Frame -->
      <div class="lg:col-span-5 fade-up-element">
        <div class="relative mx-auto max-w-md bg-white rounded-3xl p-5 border border-blush-200/80 shadow-soft">
          <div class="overflow-hidden rounded-2xl bg-cream-100 aspect-[4/3] relative">
            <Image
              src={heroShowcase}
              alt="Showcase display barang titipan di Titip Jual Izah"
              loading="eager"
              class="w-full h-full object-cover"
            />
          </div>

          <div class="mt-4 pt-4 border-t border-blush-100 flex items-center justify-between text-xs text-warmtext-muted font-body">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
              Konsultasi Aktif via WhatsApp
            </span>
            <span class="font-medium text-rosebrand-700">Fast Response</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
