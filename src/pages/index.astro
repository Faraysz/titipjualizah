---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Pricing from '../components/Pricing.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Terms from '../components/Terms.astro';
import Categories from '../components/Categories.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaFooter from '../components/CtaFooter.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';
---

<Layout
  title={`${siteConfig.brandName} - ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <!-- 1. Navbar -->
  <Navbar />

  <!-- Main Content Wrapper -->
  <main>
    <!-- 2. Hero Section -->
    <Hero />

    <!-- 3. Pilih Sistem Layanan (Terima Beres vs Titip Jual Biasa + Tabel Komparasi) -->
    <Pricing />

    <!-- 4. Alur Daftar (Titip Jual Biasa & Format Foto) -->
    <HowItWorks />

    <!-- 5. Syarat & Ketentuan Layanan (Accordion Details per Sistem) -->
    <Terms />

    <!-- 6. Kategori Barang Pilihan -->
    <Categories />

    <!-- 7. Testimoni Chat Asli & Galeri Terjual -->
    <Testimonials />

    <!-- 8. FAQ (Pertanyaan Umum) -->
    <Faq />
  </main>

  <!-- 9. Bagian Penutup Personal (Foto Izah + WhatsApp) & Footer Resmi -->
  <CtaFooter />

  <!-- 10. Tombol WhatsApp Mengambang (Auto-hide saat di section penutup) -->
  <FloatingWhatsApp />
</Layout>
